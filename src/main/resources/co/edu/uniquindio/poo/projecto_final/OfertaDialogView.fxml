<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="323.0" prefWidth="374.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.projecto_final.controllers.OfertaDialogController">
   <children>
      <Label fx:id="lblTitulo" layoutX="79.0" layoutY="24.0" text="Titulo">
         <font>
            <Font name="Bell MT" size="24.0" />
         </font>
      </Label>
      <Label fx:id="lblDetalleInmueble" layoutX="55.0" layoutY="64.0" text="Detalle Inmueble">
         <font>
            <Font name="Bell MT" size="16.0" />
         </font>
      </Label>
      <Label fx:id="lblPrecioAnterior" layoutX="57.0" layoutY="103.0" text="Precio Anterior">
         <font>
            <Font name="Bell MT" size="19.0" />
         </font>
      </Label>
      <TextField fx:id="txtNuevoPrecio" layoutX="112.0" layoutY="194.0" />
      <Label layoutX="111.0" layoutY="140.0" text="Ingrese el nuevo precio">
         <font>
            <Font name="Bell MT" size="16.0" />
         </font>
      </Label>
      <Button fx:id="btnEnviar" layoutX="23.0" layoutY="257.0" mnemonicParsing="false" onAction="#onEnviarClick" text="Enviar Oferta ">
         <font>
            <Font name="Bell MT" size="14.0" />
         </font>
      </Button>
      <Button fx:id="btnAceptarCambio" layoutX="141.0" layoutY="258.0" mnemonicParsing="false" onAction="#onAceptarCambioClick" text="Aceptar Precio">
         <font>
            <Font name="Bell MT" size="14.0" />
         </font>
      </Button>
      <Button fx:id="btnCancelar" layoutX="263.0" layoutY="258.0" mnemonicParsing="false" onAction="#onCancelarClick" text="Cancelar">
         <font>
            <Font name="Bell MT" size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
